<?xml version='1.0' encoding='utf-8'?>
<widget id="com.aryan.astore" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>A-Store</name>
  <description>A for Aryan, A for Apps — apps, gallery pictures and studio notices, made by Aryan.</description>
  <author href="https://github.com/Griffith4421">Aryan</author>
  <content src="index.html#apps" />
  <access origin="https://*" />
  <allow-navigation href="https://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="http://*/*" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="Orientation" value="default" />
  <preference name="Fullscreen" value="false" />
  <preference name="AndroidInsecureFileModeEnabled" value="false" />
  <preference name="AndroidWindowSplashScreenBackground" value="#f7f7f4" />
  <icon src="res/icon.png" />
  <plugin name="cordova-plugin-inappbrowser" spec="6.0.0" />
  <platform name="android">
    <preference name="android-minSdkVersion" value="24" />
  </platform>
</widget>
